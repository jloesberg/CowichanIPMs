stochastic_wet_ipm <- function(kernels_current_trt, ssd_list, climate_probs,
                               N0, years, reps) {
  
  results <- list()
  counter <- 1
  
  for(trt in names(kernels_current_trt)) {
    
    kernel_list <- kernels_current_trt[[trt]]
    ssd <- ssd_list[[trt]]
    
    for(wet_scenario in names(climate_probs[[trt]])) {
      
      climate_prob <- climate_probs[[trt]][[wet_scenario]]
      
      rep_lambda <- numeric(reps)
      
      for(r in 1:reps) {
        
        n <- ssd * N0
        annual_lambda <- numeric(years)
        
        for(t in 1:years) {
          
          N_before <- sum(n)
          
          # sample climate year using weighted probabilities
          K <- kernel_list[[sample(
            seq_along(kernel_list),
            size = 1,
            prob = climate_prob
          )]]
          
          n <- K %*% n
          
          N_after <- sum(n)
          
          annual_lambda[t] <- N_after / N_before
        }
        
        rep_lambda[r] <- exp(mean(log(annual_lambda)))
      }
      
      results[[counter]] <- data.frame(
        trt = trt,
        wet_scenario = wet_scenario,
        stochastic_lambda = exp(mean(log(rep_lambda))),
        lower_CI = quantile(rep_lambda, 0.025),
        upper_CI = quantile(rep_lambda, 0.975)
      )
      
      counter <- counter + 1
    }
  }
  
  do.call(rbind, results)
}

