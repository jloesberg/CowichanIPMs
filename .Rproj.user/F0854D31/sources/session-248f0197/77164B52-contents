read_and_fix <- function(file) {
  df <- read.csv(file, stringsAsFactors = FALSE)
  df$umbel.diam <- sapply(df$umbel.diam, function(x) {
    if (is.na(x)) return(NA)
    if (x == "SOS") return(x)
    if (!grepl(";", x)) return(as.numeric(x))
    sum(as.numeric(strsplit(x, ";")[[1]]), na.rm = TRUE) #htis is adding the diameters together - change if using this data!
  })
  if ("no.seeds" %in% names(df)) {
    df$no.seeds <- sapply(df$no.seeds, function(x) {
      if (is.na(x)) return(NA)
      if (!grepl(";", x)) return(as.numeric(x))
      sum(as.numeric(strsplit(x, ";")[[1]]), na.rm = TRUE)
    })
  }
  df
}

