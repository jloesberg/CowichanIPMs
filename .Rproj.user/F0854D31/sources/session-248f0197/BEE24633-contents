params <- params %>%
  mutate(
    surv.slope = survival["size"] +
      survival["size:prev_spring.mean.temp"] * prev_spring.mean.temp,

    surv.int = survival["(Intercept)"] +
      survival["prev_spring.mean.temp"] * prev_spring.mean.temp +
      survival["fall.mean.temp"] * fall.mean.temp
  )


