### 1. Growth
#gm.base.trt.int <- lmer(sizeT1 ~ size*trt + (1|Plot) + (1|Year), data = lom, REML = F)
growth <- fixef(gm.base.trt.int)

params <- params %>%
  mutate(
    growth.int = case_when(
      trt == "irrigated" ~ growth["(Intercept)"],
      trt == "control"   ~ growth["(Intercept)"] + growth["trtcontrol"],
      trt == "drought"   ~ growth["(Intercept)"] + growth["trtdrought"]
    ),
    growth.slope = case_when(
      trt == "irrigated" ~ growth["size"],
      trt == "control"   ~ growth["size"] + growth["size:trtcontrol"],
      trt == "drought"   ~ growth["size"] + growth["size:trtdrought"]
    )
  )

growth_var <- as.data.frame(VarCorr(gm.base.trt.int))
params$growth.sd <- growth_var[growth_var$grp == "Residual", "sdcor"]

### 2. pflower
flowering <- fixef(fm.base.size)

params$pflow.int<- flowering["(Intercept)"]
#slope:
params$pflow.slope <- flowering["size"]

### 3. survival
#sm.spf.int <- glmer(psurvivalT1 ~ size*prev_spring.mean.temp + fall.mean.temp + (1|Plot) + (1|Year), data = lom.surv, family = "binomial")
