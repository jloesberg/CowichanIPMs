params_list <-  filter(params) %>% split(., seq(nrow(.))) #this splits up params into X rows, which I can feed into the function below

###
mat.size = 100 #dimensions of continuous matrix
bigmatrix <- function(params_list, mat.size){

  n <- mat.size
  L <- min.size
  U <- max.size

  # mesh
  h <- (U - L) / n
  b <- L + c(0:n) * h
  y <- 0.5 * (b[1:n] + b[2:(n+1)])

  # Fertility matrix
  Fmat <- matrix(0, n, n)

  # recruits of size y from parent size x
  Fmat <- outer(y, y, function(y,x){
    f.yx(x, params_list) * recruit.size(y, params_list)
  }) * h

  # Growth/survival
  Tmat <- t(outer(y, y, P, params = params_list)) * h

  # Full kernel
  IPMmat <- Fmat + Tmat

  out_matrix <- list(
    IPMmat = IPMmat,
    Fmat = Fmat,
    Tmat = Tmat,
    meshpts = y)

  out_lamb <- data.frame(
    Year = params_list$Year,
    lambda = lambda(IPMmat),
    #prev_summer.mean.max.temp = params_list$prev_summer.mean.max.temp,
    prev_spring.mean.temp = params_list$prev_spring.mean.temp,
    fall.mean.temp = params_list$fall.mean.temp,
    prev_fall.mean.temp = params_list$prev_fall.mean.temp,
    spring.tot.precip = params_list$spring.tot.precip,
    #spring.temp = params_list$spring.mean.temp,
    #spring.tot.precip = params_list$spring.tot.precip,
    trt = params_list$trt)

return(list(
  IPMmat = IPMmat,
  Fmat = Fmat,
  Tmat = Tmat,
  meshpts = y,
  lambda = out_lamb
))}

